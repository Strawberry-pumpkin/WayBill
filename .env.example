# Supabase project (Dashboard -> Settings -> API). Leave empty in git; fill in .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used ONLY by scripts/seed-users.mjs. Never prefix with NEXT_PUBLIC_, never import it from app code:
# request handlers run as the signed-in user so Row Level Security always applies.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: shown on the driver "signed out" screen as a tap-to-call link.
NEXT_PUBLIC_DISPATCH_PHONE=

# Optional seed password for scripts/seed-users.mjs (kept out of git).
SEED_PASSWORD=
